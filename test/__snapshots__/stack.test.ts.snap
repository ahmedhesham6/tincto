// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`a deploy runs each resource after the resources that it needs, and a second deploy changes nothing: commands on the machine 1`] = `
[
  "bb machine create --provider manual --key tincto-<id> --no-wait --json",
  "bb machine rename host_1 <name>",
  "claude plugin install tools@example-tools",
  "claude plugin marketplace add example/tools",
  "claude plugin marketplace update example-tools",
  "claude plugin update tools@example-tools",
  "codex plugin add tools@example-tools",
  "codex plugin marketplace add example/tools",
  "codex plugin marketplace upgrade",
  "dpkg -s curl ca-certificates git unzip",
  "gh api user --jq .login",
  "gh auth login --hostname github.com --with-token",
  "gh auth token",
  "gh auth token",
  "gh auth token",
  "git -c http.https://github.com/.extraheader=Authorization: Basic eC1hY2Nlc3MtdG9rZW46dG9rZW4tMTIz clone https://github.com/example/alpha.git ~/repos/alpha",
  "git -c http.https://github.com/.extraheader=Authorization: Basic eC1hY2Nlc3MtdG9rZW46dG9rZW4tMTIz clone https://github.com/example/beta.git ~/repos/beta",
  "loginctl enable-linger <user>",
  "loginctl show-user <user> --property=Linger --value",
  "mise install",
  "mise prune",
  "mise reshim",
  "mise upgrade",
  "pi install git:github.com/example/pi-tools",
  "pi update git:github.com/example/pi-tools",
  "skills add vercel-labs/skills --global --yes --agent claude-code --skill find-skills",
  "skills update --global --yes",
  "systemctl --user daemon-reload",
  "systemctl --user enable t3code",
  "systemctl --user restart t3code",
  "systemctl enable --now docker",
  "systemctl enable --now tailscaled",
  "systemctl enable --now tailscaled",
  "t3 auth pairing create --ttl 1h --label tincto --base-url https://box.tail1.ts.net:9443 --json",
  "t3 project add ~/repos/alpha --title alpha",
  "t3 project add ~/repos/beta --title beta",
  "t3 service install",
  "tailscale serve --bg --https=9443 http://100.1.2.3:3999",
  "tailscale serve --https=9443 off",
  "tailscale set --hostname=<name> --ssh=true",
  "tailscale status --json",
  "tailscale status --json",
]
`;

